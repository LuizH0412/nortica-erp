# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco de dados (PostgreSQL)
DB_NAME=nortica
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Gere com: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=
# True só em desenvolvimento
DEBUG=False

# Domínio base das instâncias (cliente.DOMINIO_BASE)
DOMINIO_BASE=localhost

# E-mail de login do usuário master criado em cada instância
MASTER_EMAIL=nexum@norticatecnologia.com.br

# Chave que criptografa os certificados digitais (arquivo e senha) no banco.
# Gere uma vez e NUNCA mude (se mudar, os certificados precisam ser enviados de novo):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Vazia, usa a SECRET_KEY.
CHAVE_CERTIFICADOS=
